<div class="space-y-6">
  <div class="flex justify-between items-center">
    <div class="flex items-center gap-4">
      <%= link_to "← Back", dashboard_metrics_path, class: "text-[13px] hover:opacity-70 dm-text-muted" %>
      <div>
        <h1 class="text-[22px] font-semibold tracking-tight dm-text"><%= @metric.name %></h1>
        <p class="text-[14px] mt-1 dm-text-muted"><%= @metric.description || 'Custom metric' %></p>
      </div>
    </div>
    <div class="flex gap-2">
      <% %w[1h 6h 24h 7d].each do |range| %>
        <% active = params[:since] == range || (params[:since].nil? && range == '1h') %>
        <%= link_to range, dashboard_metric_path(@metric, since: range),
            class: "px-3 py-1.5 text-[13px] font-medium rounded-lg #{active ? 'dm-btn-primary' : 'dm-btn-secondary'}" %>
      <% end %>
    </div>
  </div>

  <!-- Stats cards -->
  <div class="grid grid-cols-4 gap-4">
    <div class="rounded-xl p-5 dm-card">
      <span class="text-[13px] dm-text-muted">Current</span>
      <p class="text-[28px] font-semibold mt-2 dm-text"><%= @stats[:current]&.round(1) || '-' %><span class="text-[14px] font-normal ml-1"><%= @metric.unit %></span></p>
    </div>
    <div class="rounded-xl p-5 dm-card">
      <span class="text-[13px] dm-text-muted">Average</span>
      <p class="text-[28px] font-semibold mt-2 dm-text"><%= @stats[:avg]&.round(1) || '-' %><span class="text-[14px] font-normal ml-1"><%= @metric.unit %></span></p>
    </div>
    <div class="rounded-xl p-5 dm-card">
      <span class="text-[13px] dm-text-muted">Minimum</span>
      <p class="text-[28px] font-semibold mt-2 dm-text"><%= @stats[:min]&.round(1) || '-' %><span class="text-[14px] font-normal ml-1"><%= @metric.unit %></span></p>
    </div>
    <div class="rounded-xl p-5 dm-card">
      <span class="text-[13px] dm-text-muted">Maximum</span>
      <p class="text-[28px] font-semibold mt-2 dm-text"><%= @stats[:max]&.round(1) || '-' %><span class="text-[14px] font-normal ml-1"><%= @metric.unit %></span></p>
    </div>
  </div>

  <!-- Chart -->
  <div class="rounded-xl p-5 dm-card">
    <h3 class="text-[14px] font-medium mb-4 dm-text">Trend</h3>
    <div class="h-64" data-controller="chart" data-chart-type-value="line" data-chart-data-value="<%= @stats[:chart_data].to_json %>">
      <canvas></canvas>
    </div>
  </div>

  <!-- Metadata -->
  <div class="rounded-xl p-5 dm-card">
    <h3 class="text-[14px] font-medium mb-4 dm-text">Details</h3>
    <div class="grid grid-cols-2 gap-4 text-[13px]">
      <div class="flex justify-between py-2 dm-table-row">
        <span class="dm-text-muted">Type</span>
        <span class="inline-block px-2 py-0.5 text-[11px] font-medium rounded dm-surface-alt dm-text-secondary"><%= @metric.kind %></span>
      </div>
      <div class="flex justify-between py-2 dm-table-row">
        <span class="dm-text-muted">Unit</span>
        <span class="dm-text"><%= @metric.unit || '-' %></span>
      </div>
      <div class="flex justify-between py-2 dm-table-row">
        <span class="dm-text-muted">Data Points</span>
        <span class="dm-text"><%= number_with_delimiter(@stats[:count] || 0) %></span>
      </div>
      <div class="flex justify-between py-2 dm-table-row">
        <span class="dm-text-muted">Created</span>
        <span class="dm-text"><%= @metric.created_at.strftime('%b %d, %Y') %></span>
      </div>
    </div>
  </div>
</div>
