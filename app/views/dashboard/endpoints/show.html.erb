<div class="space-y-6">
  <!-- Header with back link and time range -->
  <div class="flex justify-between items-center">
    <div class="flex items-center gap-4">
      <%= link_to "← Back", dashboard_endpoints_path(since: params[:since]), class: "text-[13px] hover:opacity-70 dm-text-muted" %>
      <div>
        <h1 class="text-[22px] font-semibold tracking-tight dm-text"><%= @endpoint_name %></h1>
        <div class="flex items-center gap-2 mt-1">
          <p class="text-[14px] dm-text-muted">Endpoint performance</p>
          <% if @trend_pct != 0 %>
            <%# For duration, lower is better so invert color %>
            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-medium
              <%= @trend_pct < 0 ? 'bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-400' : 'bg-red-100 text-red-700 dark:bg-red-900/30 dark:text-red-400' %>">
              <%= @trend_pct > 0 ? '&#9650;' : '&#9660;' %>
              <%= @trend_pct.abs %>% vs prev period
            </span>
          <% end %>
        </div>
      </div>
    </div>
    <div class="flex gap-2">
      <% %w[1h 6h 24h 7d].each do |range| %>
        <% active = params[:since] == range || (params[:since].nil? && range == '1h') %>
        <%= link_to range, dashboard_endpoint_path(@endpoint_name, since: range),
            class: "px-3 py-1.5 text-[13px] font-medium rounded-lg #{active ? 'dm-btn-primary' : 'dm-btn-secondary'}" %>
      <% end %>
    </div>
  </div>

  <!-- Stats cards -->
  <div class="grid grid-cols-5 gap-4">
    <!-- Requests -->
    <div class="rounded-xl p-5 dm-card">
      <span class="text-[13px] dm-text-muted">Requests</span>
      <p class="text-[28px] font-semibold mt-2 dm-text"><%= number_with_delimiter(@stats.count) %></p>
    </div>

    <!-- Avg Duration -->
    <div class="rounded-xl p-5 dm-card">
      <span class="text-[13px] dm-text-muted">Avg Duration</span>
      <p class="text-[28px] font-semibold mt-2 dm-text"><%= @stats.avg_duration&.round(0) || '—' %><span class="text-[16px] font-normal">ms</span></p>
    </div>

    <!-- P95 Duration -->
    <div class="rounded-xl p-5 dm-card">
      <span class="text-[13px] dm-text-muted">P95</span>
      <p class="text-[28px] font-semibold mt-2 dm-text"><%= @stats.p95_duration&.round(0) || '—' %><span class="text-[16px] font-normal">ms</span></p>
    </div>

    <!-- Max Duration -->
    <div class="rounded-xl p-5 dm-card">
      <span class="text-[13px] dm-text-muted">Max</span>
      <p class="text-[28px] font-semibold mt-2 dm-text-muted"><%= @stats.max_duration&.round(0) || '—' %><span class="text-[16px] font-normal">ms</span></p>
    </div>

    <!-- Error Rate -->
    <div class="rounded-xl p-5 dm-card">
      <span class="text-[13px] dm-text-muted">Error Rate</span>
      <% error_rate = @stats.count > 0 ? (@stats.error_count.to_f / @stats.count * 100).round(2) : 0 %>
      <p class="text-[28px] font-semibold mt-2 <%= error_rate > 1 ? 'dm-error' : 'dm-text' %>">
        <%= error_rate %>%
      </p>
    </div>
  </div>

  <!-- Span Kind Breakdown -->
  <% if @span_breakdown.any? %>
    <div class="rounded-xl p-5 dm-card">
      <h3 class="text-[14px] font-medium mb-4 dm-text">Time Breakdown by Span Kind</h3>
      <%
        total_span_duration = @span_breakdown.values.sum { |s| s.total_duration.to_f }
        span_kinds = @span_breakdown.sort_by { |_, s| -s.total_duration.to_f }
      %>
      <% if total_span_duration > 0 %>
        <!-- Stacked bar -->
        <div class="flex rounded-lg overflow-hidden h-6 mb-4">
          <% span_kinds.each do |kind, stats| %>
            <% pct = (stats.total_duration.to_f / total_span_duration * 100).round(1) %>
            <div class="<%= case kind
                            when 'db' then 'bg-purple-500'
                            when 'http' then 'bg-blue-500'
                            when 'cache' then 'bg-amber-500'
                            when 'render' then 'bg-orange-500'
                            else 'bg-stone-400'
                            end %>"
                 style="width: <%= pct %>%;"
                 title="<%= kind.upcase %>: <%= pct %>%">
            </div>
          <% end %>
        </div>

        <!-- Legend -->
        <div class="flex flex-wrap gap-4">
          <% span_kinds.each do |kind, stats| %>
            <% pct = (stats.total_duration.to_f / total_span_duration * 100).round(1) %>
            <div class="flex items-center gap-2 text-[13px]">
              <span class="w-3 h-3 rounded-sm <%= case kind
                            when 'db' then 'bg-purple-500'
                            when 'http' then 'bg-blue-500'
                            when 'cache' then 'bg-amber-500'
                            when 'render' then 'bg-orange-500'
                            else 'bg-stone-400'
                            end %>"></span>
              <span class="dm-text font-medium"><%= kind.upcase %></span>
              <span class="dm-text-muted"><%= pct %>% (<%= number_with_delimiter(stats.count) %> spans, <%= stats.total_duration.to_f.round(0) %>ms total)</span>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>

  <!-- Charts -->
  <div class="grid grid-cols-2 gap-6">
    <!-- Requests per Minute chart -->
    <div class="rounded-xl p-5 dm-card">
      <h3 class="text-[14px] font-medium mb-4 dm-text">Requests per Minute</h3>
      <div class="h-48" data-controller="chart" data-chart-type-value="line" data-chart-data-value="<%= @rpm_data.to_json %>">
        <canvas></canvas>
      </div>
    </div>

    <!-- Response Time chart -->
    <div class="rounded-xl p-5 dm-card">
      <h3 class="text-[14px] font-medium mb-4 dm-text">Response Time</h3>
      <div class="h-48" data-controller="chart" data-chart-type-value="line" data-chart-data-value="<%= @response_time_data.to_json %>">
        <canvas></canvas>
      </div>
    </div>
  </div>

  <!-- Recent Requests -->
  <div class="rounded-xl overflow-hidden dm-card">
    <div class="p-5 border-b dm-border" style="border-bottom-width: 1px; border-bottom-style: solid;">
      <h3 class="text-[14px] font-medium dm-text">Recent Requests</h3>
    </div>
    <table class="w-full">
      <thead class="dm-table-header">
        <tr class="text-left text-[13px]">
          <th class="p-4 font-medium">Duration</th>
          <th class="p-4 font-medium">Status</th>
          <th class="p-4 font-medium">Time</th>
          <th class="p-4 font-medium">DB</th>
          <th class="p-4 font-medium">View</th>
        </tr>
      </thead>
      <tbody>
        <% @recent_requests.each do |trace| %>
          <%= link_to dashboard_trace_path(trace.trace_id), class: "contents" do %>
            <tr class="hover:opacity-80 cursor-pointer dm-table-row">
              <td class="p-4 font-mono text-[14px] font-medium dm-text"><%= trace.duration_ms&.round(0) || '-' %>ms</td>
              <td class="p-4">
                <% if trace.error %>
                  <span class="px-2 py-1 text-[12px] font-medium rounded dm-badge-error">Error</span>
                <% else %>
                  <span class="px-2 py-1 text-[12px] font-medium rounded dm-badge-success">OK</span>
                <% end %>
              </td>
              <td class="p-4 text-[13px] dm-text-muted"><%= time_ago_in_words(trace.started_at) %> ago</td>
              <td class="p-4 font-mono text-[13px] dm-text-muted"><%= trace.db_duration_ms&.round(0) || 0 %>ms</td>
              <td class="p-4 font-mono text-[13px] dm-text-muted"><%= trace.view_duration_ms&.round(0) || 0 %>ms</td>
            </tr>
          <% end %>
        <% end %>

        <% if @recent_requests.empty? %>
          <tr>
            <td colspan="5" class="p-8 text-center text-[14px] dm-text-muted">
              No requests found
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
