<div class="space-y-6">
  <% if @alert_rule.errors.any? %>
    <div class="rounded-xl p-4 bg-red-50 dark:bg-red-950/20 border border-red-200 dark:border-red-800/40">
      <p class="text-[14px] font-medium text-red-800 dark:text-red-300"><%= pluralize(@alert_rule.errors.count, "error") %> prevented this rule from being saved:</p>
      <ul class="mt-2 text-[13px] list-disc list-inside text-red-800 dark:text-red-300">
        <% @alert_rule.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-2 gap-6">
    <!-- Basic Info -->
    <div class="rounded-xl p-5" style="background: var(--dm-surface); border: 1px solid var(--dm-border);">
      <h3 class="text-[14px] font-medium mb-4" style="color: var(--dm-text);">Basic Info</h3>

      <div class="space-y-4">
        <div>
          <label class="block text-[13px] mb-1.5" style="color: var(--dm-text-secondary);">Name</label>
          <%= f.text_field :name, class: "w-full px-3 py-2 rounded-lg text-[14px]", style: "background: var(--dm-input-bg); border: 1px solid var(--dm-input-border); color: var(--dm-text);", placeholder: "High error rate" %>
        </div>

        <div>
          <label class="block text-[13px] mb-1.5" style="color: var(--dm-text-secondary);">Description</label>
          <%= f.text_area :description, rows: 2, class: "w-full px-3 py-2 rounded-lg text-[14px]", style: "background: var(--dm-input-bg); border: 1px solid var(--dm-input-border); color: var(--dm-text);", placeholder: "Alert when error rate exceeds threshold" %>
        </div>

        <div class="flex items-center gap-2">
          <%= f.check_box :enabled, class: "rounded accent-green-500" %>
          <label class="text-[13px]" style="color: var(--dm-text-secondary);">Enabled</label>
        </div>
      </div>
    </div>

    <!-- Condition -->
    <div class="rounded-xl p-5" style="background: var(--dm-surface); border: 1px solid var(--dm-border);">
      <h3 class="text-[14px] font-medium mb-4" style="color: var(--dm-text);">Condition</h3>

      <div class="space-y-4">
        <div>
          <label class="block text-[13px] mb-1.5" style="color: var(--dm-text-secondary);">Metric</label>
          <%= f.select :metric_type, AlertRule::METRIC_TYPES.map { |t| [t.titleize, t] }, {}, class: "w-full px-3 py-2 rounded-lg text-[14px]", style: "background: var(--dm-input-bg); border: 1px solid var(--dm-input-border); color: var(--dm-text);" %>
        </div>

        <div class="grid grid-cols-3 gap-3">
          <div>
            <label class="block text-[13px] mb-1.5" style="color: var(--dm-text-secondary);">Operator</label>
            <%= f.select :operator, [['>', 'gt'], ['>=', 'gte'], ['<', 'lt'], ['<=', 'lte'], ['=', 'eq']], {}, class: "w-full px-3 py-2 rounded-lg text-[14px]", style: "background: var(--dm-input-bg); border: 1px solid var(--dm-input-border); color: var(--dm-text);" %>
          </div>

          <div>
            <label class="block text-[13px] mb-1.5" style="color: var(--dm-text-secondary);">Threshold</label>
            <%= f.number_field :threshold, step: "any", class: "w-full px-3 py-2 rounded-lg text-[14px]", style: "background: var(--dm-input-bg); border: 1px solid var(--dm-input-border); color: var(--dm-text);", placeholder: "5" %>
          </div>

          <div>
            <label class="block text-[13px] mb-1.5" style="color: var(--dm-text-secondary);">Aggregation</label>
            <%= f.select :aggregation, AlertRule::AGGREGATIONS.map { |a| [a.upcase, a] }, {}, class: "w-full px-3 py-2 rounded-lg text-[14px]", style: "background: var(--dm-input-bg); border: 1px solid var(--dm-input-border); color: var(--dm-text);" %>
          </div>
        </div>

        <div>
          <label class="block text-[13px] mb-1.5" style="color: var(--dm-text-secondary);">Time Window (minutes)</label>
          <%= f.number_field :window_minutes, class: "w-full px-3 py-2 rounded-lg text-[14px]", style: "background: var(--dm-input-bg); border: 1px solid var(--dm-input-border); color: var(--dm-text);", placeholder: "5" %>
        </div>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-2 gap-6">
    <!-- Filters -->
    <div class="rounded-xl p-5" style="background: var(--dm-surface); border: 1px solid var(--dm-border);">
      <h3 class="text-[14px] font-medium mb-4" style="color: var(--dm-text);">Filters (Optional)</h3>

      <div class="space-y-4">
        <div>
          <label class="block text-[13px] mb-1.5" style="color: var(--dm-text-secondary);">Endpoint</label>
          <%= f.text_field :endpoint, class: "w-full px-3 py-2 rounded-lg text-[14px]", style: "background: var(--dm-input-bg); border: 1px solid var(--dm-input-border); color: var(--dm-text);", placeholder: "/api/v1/users" %>
        </div>

        <div>
          <label class="block text-[13px] mb-1.5" style="color: var(--dm-text-secondary);">Environment</label>
          <%= f.text_field :environment, class: "w-full px-3 py-2 rounded-lg text-[14px]", style: "background: var(--dm-input-bg); border: 1px solid var(--dm-input-border); color: var(--dm-text);", placeholder: "production" %>
        </div>
      </div>
    </div>

    <!-- Notification Settings -->
    <div class="rounded-xl p-5" style="background: var(--dm-surface); border: 1px solid var(--dm-border);">
      <h3 class="text-[14px] font-medium mb-4" style="color: var(--dm-text);">Notification Settings</h3>

      <div class="space-y-4">
        <div>
          <label class="block text-[13px] mb-1.5" style="color: var(--dm-text-secondary);">Severity</label>
          <%= f.select :severity, AlertRule::SEVERITIES.map { |s| [s.titleize, s] }, {}, class: "w-full px-3 py-2 rounded-lg text-[14px]", style: "background: var(--dm-input-bg); border: 1px solid var(--dm-input-border); color: var(--dm-text);" %>
        </div>

        <div>
          <label class="block text-[13px] mb-1.5" style="color: var(--dm-text-secondary);">Cooldown (minutes)</label>
          <%= f.number_field :cooldown_minutes, class: "w-full px-3 py-2 rounded-lg text-[14px]", style: "background: var(--dm-input-bg); border: 1px solid var(--dm-input-border); color: var(--dm-text);", placeholder: "60" %>
          <p class="text-[12px] mt-1" style="color: var(--dm-text-muted);">Don't re-alert within this period</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Notification Channels -->
  <div class="rounded-xl p-5" style="background: var(--dm-surface); border: 1px solid var(--dm-border);">
    <h3 class="text-[14px] font-medium mb-4" style="color: var(--dm-text);">Notification Channels</h3>

    <% if @notification_channels.any? %>
      <div class="space-y-2">
        <% @notification_channels.each do |channel| %>
          <label class="flex items-center gap-3 p-3 rounded-lg cursor-pointer hover:bg-stone-50 dark:hover:bg-stone-800/30" style="border: 1px solid var(--dm-border);">
            <%= check_box_tag "alert_rule[notification_channel_ids][]", channel.id, @alert_rule.notification_channel_ids.include?(channel.id), class: "rounded accent-green-500" %>
            <div class="flex-1">
              <p class="text-[14px] font-medium" style="color: var(--dm-text);"><%= channel.name %></p>
              <p class="text-[13px]" style="color: var(--dm-text-secondary);"><%= channel.kind.titleize %></p>
            </div>
          </label>
        <% end %>
      </div>
    <% else %>
      <p class="text-[14px]" style="color: var(--dm-text-muted);">
        No notification channels configured.
        <%= link_to "Create one", new_dashboard_notification_channel_path, style: "color: var(--dm-text);" %>
      </p>
    <% end %>
  </div>

  <div class="flex justify-end gap-3">
    <%= link_to "Cancel", dashboard_alert_rules_path, class: "px-4 py-2 text-[14px] font-medium rounded-lg", style: "background: var(--dm-surface); border: 1px solid var(--dm-border); color: var(--dm-text-secondary);" %>
    <%= f.submit "Save Rule", class: "px-4 py-2 text-[14px] font-medium rounded-lg cursor-pointer", style: "background: var(--dm-text); color: var(--dm-surface);" %>
  </div>
</div>
