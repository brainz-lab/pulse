<div class="space-y-6">
  <div class="flex justify-between items-center">
    <div>
      <h1 class="text-[22px] font-semibold tracking-tight dm-text">Requests</h1>
      <p class="text-[14px] mt-1 dm-text-muted">Recent HTTP requests and background jobs</p>
    </div>
    <div class="flex gap-2">
      <% %w[1h 6h 24h 7d].each do |range| %>
        <% active = params[:since] == range || (params[:since].nil? && range == '1h') %>
        <%= link_to range, dashboard_requests_path(since: range),
            class: "px-3 py-1.5 text-[13px] font-medium rounded-lg #{active ? 'dm-btn-primary' : 'dm-btn-secondary'}" %>
      <% end %>
    </div>
  </div>

  <!-- Filter Bar -->
  <div class="rounded-xl p-4 dm-card">
    <%= form_with url: dashboard_requests_path, method: :get, local: true, class: "space-y-3" do %>
      <%= hidden_field_tag :since, params[:since] %>

      <div class="flex flex-wrap items-center gap-3">
        <%# Quick filter buttons %>
        <div class="flex gap-2">
          <% [['All', {}], ['Slow', { slow: true }], ['Errors', { errors: true }]].each do |label, filter_params| %>
            <% active = (filter_params[:slow] && params[:slow]) || (filter_params[:errors] && params[:errors]) || (filter_params.empty? && !params[:slow] && !params[:errors]) %>
            <%= link_to label, dashboard_requests_path(since: params[:since], **filter_params),
                class: "px-3 py-1.5 text-[13px] font-medium rounded-lg #{active ? 'dm-btn-primary' : 'dm-btn-secondary'}" %>
          <% end %>
        </div>

        <div class="w-px h-6 dm-border" style="border-right-width: 1px; border-right-style: solid;"></div>

        <%# Controller filter %>
        <% if @controllers.any? %>
          <select name="controller_name" class="px-3 py-1.5 text-[13px] rounded-lg dm-input">
            <option value="">All Controllers</option>
            <% @controllers.each do |ctrl| %>
              <option value="<%= ctrl %>" <%= 'selected' if params[:controller_name] == ctrl %>><%= ctrl %></option>
            <% end %>
          </select>
        <% end %>

        <%# HTTP Method filter %>
        <select name="method" class="px-3 py-1.5 text-[13px] rounded-lg dm-input">
          <option value="">All Methods</option>
          <% %w[GET POST PUT PATCH DELETE].each do |method| %>
            <option value="<%= method %>" <%= 'selected' if params[:method] == method %>><%= method %></option>
          <% end %>
        </select>

        <%# Host filter %>
        <% if @hosts.any? %>
          <select name="host" class="px-3 py-1.5 text-[13px] rounded-lg dm-input">
            <option value="">All Hosts</option>
            <% @hosts.each do |host| %>
              <option value="<%= host %>" <%= 'selected' if params[:host] == host %>><%= host %></option>
            <% end %>
          </select>
        <% end %>

        <%# Environment filter %>
        <% if @environments.any? %>
          <select name="environment" class="px-3 py-1.5 text-[13px] rounded-lg dm-input">
            <option value="">All Environments</option>
            <% @environments.each do |env| %>
              <option value="<%= env %>" <%= 'selected' if params[:environment] == env %>><%= env %></option>
            <% end %>
          </select>
        <% end %>

        <%# Duration range %>
        <div class="flex items-center gap-1">
          <input type="number" name="min_duration" value="<%= params[:min_duration] %>"
                 placeholder="Min ms" step="1" min="0"
                 class="w-20 px-2 py-1.5 text-[13px] rounded-lg dm-input">
          <span class="text-[12px] dm-text-muted">-</span>
          <input type="number" name="max_duration" value="<%= params[:max_duration] %>"
                 placeholder="Max ms" step="1" min="0"
                 class="w-20 px-2 py-1.5 text-[13px] rounded-lg dm-input">
        </div>

        <button type="submit" class="px-4 py-1.5 text-[13px] font-medium rounded-lg dm-btn-primary">
          Filter
        </button>

        <% if params[:controller_name].present? || params[:method].present? || params[:host].present? || params[:environment].present? || params[:min_duration].present? || params[:max_duration].present? %>
          <%= link_to "Clear", dashboard_requests_path(since: params[:since]),
              class: "px-3 py-1.5 text-[13px] font-medium rounded-lg dm-btn-secondary" %>
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="rounded-xl overflow-hidden dm-card">
    <table class="w-full">
      <thead class="dm-table-header">
        <tr class="text-left text-[13px]">
          <th class="p-4 font-medium">Name</th>
          <th class="p-4 font-medium">Status</th>
          <th class="p-4 font-medium">Duration</th>
          <th class="p-4 font-medium">DB</th>
          <th class="p-4 font-medium">Time</th>
        </tr>
      </thead>
      <tbody>
        <% @traces.each do |trace| %>
          <tr class="hover:opacity-80 dm-table-row">
            <td class="p-4">
              <%= link_to trace.name, dashboard_trace_path(trace.trace_id), class: "text-[14px] font-medium hover:opacity-70 dm-text" %>
            </td>
            <td class="p-4">
              <span class="text-[13px] <%= trace.error ? 'dm-error' : 'dm-success' %>">
                <%= trace.status || (trace.error ? 'Error' : 'OK') %>
              </span>
            </td>
            <td class="p-4 font-mono text-[13px] dm-text">
              <%= trace.duration_ms&.round(0) || '-' %>ms
            </td>
            <td class="p-4 text-[13px] dm-text-muted">
              <%= trace.db_duration_ms&.round(0) || 0 %>ms
            </td>
            <td class="p-4 text-[13px] dm-text-muted">
              <%= time_ago_in_words(trace.started_at) %> ago
            </td>
          </tr>
        <% end %>

        <% if @traces.empty? %>
          <tr>
            <td colspan="5" class="p-8 text-center text-[14px] dm-text-muted">
              No requests found
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%# Pagination %>
  <% if @pagy.pages > 1 %>
    <div class="flex justify-between items-center text-[13px] dm-text-muted">
      <div>
        Showing <%= @pagy.from %>-<%= @pagy.to %> of <%= @pagy.count %> requests
      </div>
      <div class="flex gap-1">
        <% if @pagy.prev %>
          <%= link_to "Previous", url_for(page: @pagy.prev),
              class: "px-3 py-1.5 rounded-lg dm-btn-secondary" %>
        <% end %>
        <% @pagy.series.each do |item| %>
          <% if item == :gap %>
            <span class="px-3 py-1.5">...</span>
          <% elsif item.is_a?(Integer) %>
            <%= link_to item, url_for(page: item),
                class: "px-3 py-1.5 rounded-lg dm-btn-secondary" %>
          <% else %>
            <span class="px-3 py-1.5 rounded-lg dm-btn-primary"><%= item %></span>
          <% end %>
        <% end %>
        <% if @pagy.next %>
          <%= link_to "Next", url_for(page: @pagy.next),
              class: "px-3 py-1.5 rounded-lg dm-btn-secondary" %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
